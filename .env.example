# Публичные значения: уходят в браузер, это нормально.
# Все права разграничены политиками RLS в базе.
VITE_SUPABASE_URL=https://ваш-проект.supabase.co
VITE_SUPABASE_ANON_KEY=ваш_anon_public_ключ

# Только для локальных скриптов (создание пользователей, тестовые данные).
# В браузер и в репозиторий не попадает: .env в .gitignore.
SUPABASE_SERVICE_ROLE_KEY=ваш_service_role_ключ
DATABASE_URL=postgresql://postgres:пароль@db.ваш-проект.supabase.co:5432/postgres
